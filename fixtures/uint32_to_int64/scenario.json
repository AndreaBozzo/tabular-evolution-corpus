{
  "schema_version": "1.0",
  "scenario_id": "uint32_to_int64",
  "title": "uint32 to int64",
  "category": "numeric",
  "description": "A uint32 column becomes int64. Every uint32 fits in int64, so every value is unchanged. Values include 2^31 - 1, 2^31 and 2^32 - 1: the last two are outside the int32 range.",
  "notes": [
    "Parquet stores uint32 as physical INT32 with an unsigned Int(32) annotation, so 2^31 and 2^32 - 1 are stored as the negative INT32 bit patterns -2147483648 and -1. A reader that ignores the annotation reads those numbers."
  ],
  "tags": [
    "change-type",
    "integer",
    "unsigned",
    "widening",
    "numeric-extremes"
  ],
